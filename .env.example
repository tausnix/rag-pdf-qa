# Copy to .env and fill in. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.0-flash is the "Flash" tier: cheap + fast, good enough for grounded QA.
GEMINI_MODEL=gemini-2.0-flash

# Embedding backend: auto | st | onnx | hash
#   st   = sentence-transformers (all-MiniLM-L6-v2, exactly as on the resume)
#   onnx = chromadb's ONNX build of all-MiniLM-L6-v2 (no torch needed)
#   hash = deterministic toy embedder, for offline tests ONLY (metrics are meaningless)
EMBED_BACKEND=auto

# --- optional cross-encoder rerank (--mode rerank / --rerank) ---
# int8 ONNX export, downloaded on first use to ~/.cache/rag-pdf-qa/
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=15
# pairs are padded to the longest in each batch, then truncated at this hard cap
RERANK_MAX_LENGTH=256
# RERANK_MODEL_DIR=C:\path\to\folder\with\model.onnx+tokenizer.json

# --- generation cost model (USD per 1M tokens, Gemini 2.0 Flash list price) ---
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.40

# --- lexical faithfulness proxy ---
FAITHFULNESS_MIN_OVERLAP=0.6
