# Copy to .env and fill in. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-flash-latest tracks Google's current Flash model, so the id never rots.
# (gemini-2.0-flash was shut down on 2026-06-01; calls to it now return 404.)
GEMINI_MODEL=gemini-flash-latest
# Tried in order when the primary id is retired or unsupported.
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-2.5-flash
# 3.x Flash models think before answering; 0 turns that off so the token budget
# goes to the answer. Dropped automatically if the model rejects it.
GEMINI_THINKING_BUDGET=0

# --- Gemini free-tier pacing + response cache (used by --llm) ---
# AI Studio free tier enforces requests-per-minute across Flash models. 4 s keeps
# a benchmark near 15 RPM; a 429 is retried with backoff (RetryInfo/Retry-After
# first, then exponential from GEMINI_BACKOFF_BASE_S, capped at 60 s).
GEMINI_MIN_INTERVAL_S=4
GEMINI_MAX_RETRIES=5
GEMINI_BACKOFF_BASE_S=4
# Every successful response is cached by sha256(model+temperature+prompt), so an
# interrupted 225-query run resumes from disk instead of spending quota again.
# Default directory: ~/.cache/rag-pdf-qa/gemini
GEMINI_CACHE=1
# GEMINI_CACHE_DIR=C:\Users\you\.cache\rag-pdf-qa\gemini

# Embedding backend: auto | st | onnx | hash
#   st   = sentence-transformers (all-MiniLM-L6-v2, exactly as on the resume)
#   onnx = chromadb's ONNX build of all-MiniLM-L6-v2 (no torch needed)
#   hash = deterministic toy embedder, for offline tests ONLY (metrics are meaningless)
EMBED_BACKEND=auto

# --- optional cross-encoder rerank (--mode rerank / --rerank) ---
# int8 ONNX export, downloaded on first use to ~/.cache/rag-pdf-qa/
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_TOP_N=15
# pairs are padded to the longest in each batch, then truncated at this hard cap
RERANK_MAX_LENGTH=256
# RERANK_MODEL_DIR=C:\path\to\folder\with\model.onnx+tokenizer.json

# --- generation cost model (USD per 1M tokens, Gemini 3.8 Flash promo price) ---
# gemini-flash-latest resolves to 3.8 Flash. Promo rates run through 2026-12-31;
# the standard rate from 2027-01-01 is 1.50 in / 7.50 out.
PRICE_INPUT_PER_MTOK=0.75
PRICE_OUTPUT_PER_MTOK=3.75

# --- lexical faithfulness proxy ---
FAITHFULNESS_MIN_OVERLAP=0.6
