# Copy to .env and fill in. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# gemini-2.0-flash is the "Flash" tier: cheap + fast, good enough for grounded QA.
GEMINI_MODEL=gemini-2.0-flash

# Embedding backend: auto | st | onnx | hash
#   st   = sentence-transformers (all-MiniLM-L6-v2, exactly as on the resume)
#   onnx = chromadb's ONNX build of all-MiniLM-L6-v2 (no torch needed)
#   hash = deterministic toy embedder, for offline tests ONLY (metrics are meaningless)
EMBED_BACKEND=auto
